{
  "name": "@tryforge/reforge.db",
  "version": "3.0.0",
  "description": "ReForgeDB: a reworked, hardened and faster database extension for ForgeScript (SQLite, better-sqlite3, MySQL/MariaDB, PostgreSQL, MongoDB). Fork of tryforge/ForgeDB.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test --test-concurrency=1 test/*.test.js",
    "docgen": "tsc && node dist/docgen",
    "docs": "tsc && typedoc src/index.ts",
    "commit": "npm run docgen && node dist/commit",
    "prettier": "prettier --write \"./src/**/*.ts\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Demonic1594/ReForgeDB.git"
  },
  "keywords": [
    "discord",
    "extension",
    "forge",
    "forgescript",
    "reforge",
    "reforgedb",
    "database",
    "db",
    "sqlite",
    "mysql",
    "postgres",
    "mongodb",
    "typeorm"
  ],
  "author": "aggelos007 (original), Demonic1594 (fork)",
  "license": "GPL-3.0",
  "devDependencies": {
    "@tryforge/forgescript": "^2.8.0",
    "@types/node": "^22.20.5",
    "discord.js": "^14.27.0",
    "mongodb": "^6.19.0",
    "prettier": "^3.5.3",
    "sqlite3": "^6.0.1",
    "typedoc": "^0.26.11",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "reflect-metadata": "^0.2.2",
    "tiny-typed-emitter": "^2.1.0",
    "typeorm": "^0.3.31"
  },
  "peerDependencies": {
    "@tryforge/forgescript": ">=2.5.0"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "metadata",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "bugs": {
    "url": "https://github.com/Demonic1594/ReForgeDB/issues"
  },
  "homepage": "https://github.com/Demonic1594/ReForgeDB#readme"
}
